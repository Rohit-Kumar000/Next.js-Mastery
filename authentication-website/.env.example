# MongoDB connection string (replace <db_password> with your database user's password)
MONGO_URL=mongodb+srv://authentication-user:<db_password>@authentication.xbvtpcx.mongodb.net/

# Secret used to sign login tokens (JWT). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=xxxx

# Public URL of the app. Used to build the links inside emails
DOMAIN=http://localhost:3000

# SMTP settings (Mailtrap sandbox works well for development)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=xxxx
SMTP_PASS=xxxx
EMAIL_FROM="Authentication App <from@example.com>"
