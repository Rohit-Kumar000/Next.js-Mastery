# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
# Your site URL (use your real domain in production)
NEXTAUTH_URL=http://localhost:3000

# Resend (verification emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google AI Studio (AI message suggestions)
GEMINI_API_KEY=your-google-ai-studio-api-key
# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
